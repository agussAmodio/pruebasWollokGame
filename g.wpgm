import wollok.game.*
import personajes.*
import managerDeBatallas.*
import opcionMenu.*
import barraDeVida.*
import minijuegos.*

program juego {
    game.title("Combate por Turnos")
    game.height(10)
    game.width(15)
    game.boardGround("mapaDojoCombate.png")

    // 2. CREACIÓN DE LOS PERSONAJES (Instancias)
    const heroe = new Personaje(
        nombre = "Héroe", 
        vidaMaxima = 100, 
        fuerza = 25, 
        defensa = 10,
        position = game.at(3, 2), 
        image = "jugadorPiernas.png"
    )

    const rival = new Personaje(
        nombre = "Rival", 
        vidaMaxima = 2000000, 
        fuerza = 20, 
        defensa = 12,
        position = game.at(10, 4), 
        image = "enemigoCombate1.png"
    )

    const batallaDeEntrenamiento = new ManagerDeBatalla(jugador = heroe, enemigo = rival)

    const barraDeVidaAliado = new MarcadorVida(personaje = heroe, position = game.at(3, 7))
    const barraDeVidaEnemigo = new MarcadorVida(personaje = rival, position = game.at(10, 8))

    const menuAcciones = new OpcionMenu(position = game.at(9 , 0), image = "cuadroAcciones2.png")
    const cuadroDialogo = new OpcionMenu(position = game.at(0, 0), image = "cuadroDecision.png")

    keyboard.a().onPressDo({ batallaDeEntrenamiento.procesarAtaqueJugador() })   
    keyboard.r().onPressDo({ batallaDeEntrenamiento.procesarRendicionJugador() })   
    keyboard.e().onPressDo({ batallaDeEntrenamiento.procesarPocionJugador() })     
    keyboard.d().onPressDo({ batallaDeEntrenamiento.procesarDefensaJugador() })    
    keyboard.x().onPressDo({ miniJuegoCuracion.registrarClick() })


    game.addVisual(heroe)
    game.addVisual(rival)
    game.addVisual(menuAcciones)
    game.addVisual(cuadroDialogo)
    game.addVisual(barraDeVidaAliado)
    game.addVisual(barraDeVidaEnemigo)

    game.start()
}